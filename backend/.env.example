# OpenAI API key (required unless DEMO_MODE=true and you're fine with template fallbacks)
OPENAI_API_KEY=

# Vision-capable model for hazard photo analysis. Must be a model your account can access.
VLM_MODEL=gpt-4.1-mini

# Cheaper/faster text model for profile parsing and route explanations.
TEXT_MODEL=gpt-4.1-mini

# Neighborhood bounding box (north, south, east, west) — default: Oakland, Pittsburgh
BBOX_NORTH=40.450
BBOX_SOUTH=40.435
BBOX_EAST=-79.945
BBOX_WEST=-79.965

# Demo start/end coordinates (placeholders — replace after scouting the area)
DEMO_START_LAT=40.4406
DEMO_START_LON=-79.9563
DEMO_END_LAT=40.4443
DEMO_END_LON=-79.9553

# How many days until a report's confidence fully decays to zero
REPORT_DECAY_DAYS=14

# When true: VLM/LLM calls fall back to cached/templated responses on failure or timeout,
# so the demo never dies on bad wifi or a missing API key.
DEMO_MODE=true
